# Server Port
PORT=3000

# Security - Create a long, random secret. Clients must send this in header: X-API-Key
SECRET_API_KEY=your_secret_api_key_here

# Discord Webhooks - Create webhooks in your Discord server settings
DISCORD_WEBHOOK_DONATE=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_FEEDBACK=https://discord.com/api/webhooks/...
